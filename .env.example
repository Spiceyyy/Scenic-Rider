# Copy to .env and change the password. .env is git-ignored.
POSTGRES_DB=scenic
POSTGRES_USER=scenic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

DATABASE_URL=postgresql://scenic:change-me@localhost:5433/scenic
SCENIC_DB_SCHEMA=scenic

# Optional: enables DB integration tests. Tests create and DROP a throwaway schema.
# TEST_DATABASE_URL=postgresql://scenic:change-me@localhost:5433/scenic

# Mapillary API token, used by request.py / build_graph.py
MAPILLARY_TOKEN=your-mapillary-token
